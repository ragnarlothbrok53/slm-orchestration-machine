# Copy to .env and adjust. Every setting can also be passed as an environment variable.
# Full list, types and bounds: src/slom/config.py.

# Journal (SQLite). Shared by the API and every worker on this host.
SLOM_DB_PATH=slom.db
# FULL: finished steps survive power loss. NORMAL: survive process crashes only; cheaper commits.
SLOM_DB_SYNCHRONOUS=FULL

# Worker
SLOM_MAX_CONCURRENT_RUNS=8
# A crashed worker's runs resume elsewhere after this many seconds without a heartbeat.
SLOM_LEASE_S=15
SLOM_POLL_INTERVAL_S=0.2
SLOM_MAX_RUN_ATTEMPTS=5
SLOM_SHUTDOWN_GRACE_S=10

# LLM server (slim-serve or any OpenAI-compatible /v1/completions server)
SLOM_LLM_BASE_URL=http://127.0.0.1:8000
# Keep above the server's SLM_REQUEST_TIMEOUT_S (120) so its 504 arrives first.
SLOM_LLM_TIMEOUT_S=130
# 8 attempts ride out roughly 45-90s of LLM server downtime (e.g. a restart + model load).
SLOM_LLM_MAX_ATTEMPTS=8
# LLM calls in flight per worker. Set to the server's SLM_REPLICAS; never above
# replicas + SLM_MAX_QUEUE_SIZE (beyond that the server answers 503; see benchmarks).
SLOM_LLM_CONCURRENCY=1

# API
SLOM_API_HOST=127.0.0.1
SLOM_API_PORT=8080
SLOM_API_WAIT_TIMEOUT_S=60

# Observability (worker Prometheus port; 0 disables. The API serves /metrics itself.)
SLOM_METRICS_PORT=9464
SLOM_LOG_LEVEL=INFO
SLOM_LOG_JSON=false
